# ========================================================
# Cosplay Planner - Voice TTS Environment Variables Template
# Copy this file to .env and fill in your keys.
# ========================================================

# ElevenLabs Settings (Main Engine)
# Sign up at https://elevenlabs.io (Free tier gives 10,000 credits/mo)
# Under Profile > API Keys, click "+ Create API Key" and copy the secret key starting with 'sk_'
ELEVENLABS_API_KEY=your_elevenlabs_secret_key_here
# Low-cost Flash/Turbo model recommended for free-tier: eleven_flash_v2_5, eleven_turbo_v2_5, or eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Azure Speech Settings (Backup Engine - Optional)
# Create a free Speech resource in Azure Portal (Free F0 tier: 500,000 characters/month)
# Copy Key 1 and Location/Region (e.g., eastus, westus2)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Server Proxy Port (defaults to 3001)
PORT=3001
